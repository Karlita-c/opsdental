{
  "name": "OpsDental — Post-cita: pedir calificación",
  "nodes": [
    {
      "id": "cron-postcita",
      "name": "Cron cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "position": [250, 300]
    },
    {
      "id": "get-terminadas",
      "name": "Obtener citas terminadas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.OPSDENTAL_API_URL }}/api/n8n/citas-terminadas",
        "queryParameters": {
          "parameters": [{ "name": "horas", "value": "2" }]
        }
      },
      "position": [450, 300]
    },
    {
      "id": "loop-postcita",
      "name": "Por cada paciente",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "parameters": { "batchSize": 1 },
      "position": [650, 300]
    },
    {
      "id": "wa-postcita",
      "name": "WA: Pedir calificación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "headers": { "Authorization": "=Bearer {{ $env.WHATSAPP_TOKEN }}" },
        "body": {
          "messaging_product": "whatsapp",
          "to": "={{ $json.telefono }}",
          "type": "text",
          "text": {
            "body": "=⭐ Hola {{ $json.nombre }}, esperamos que tu cita de hoy en *{{ $json.consultorio }}* haya sido excelente.\n\n¿Cómo calificarías tu experiencia?\n\nResponde con un número del *1 al 5*:\n1 = Muy malo  ·  5 = Excelente\n\n¡Tu opinión nos ayuda a mejorar! 🦷"
          }
        }
      },
      "position": [850, 300]
    }
  ],
  "connections": {
    "Cron cada hora":          { "main": [[{ "node": "Obtener citas terminadas", "type": "main", "index": 0 }]] },
    "Obtener citas terminadas":{ "main": [[{ "node": "Por cada paciente",        "type": "main", "index": 0 }]] },
    "Por cada paciente":       { "main": [[{ "node": "WA: Pedir calificación",   "type": "main", "index": 0 }]] }
  }
}
