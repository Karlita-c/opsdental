{
  "name": "OpsDental — Webhook confirmación/cancelación WhatsApp",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook Meta WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "parameters": {
        "path": "whatsapp-incoming",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "position": [240, 300]
    },
    {
      "id": "2",
      "name": "Extraer mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "parameters": {
        "jsCode": "const msg = items[0].json;\nconst telefono = msg?.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.from ?? '';\nconst raw = msg?.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.text?.body ?? '';\nconst texto = raw.toUpperCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim();\nreturn [{ json: { telefono, texto } }];"
      },
      "position": [460, 300]
    },
    {
      "id": "3",
      "name": "¿Es SI?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.texto }}",
              "operation": "equal",
              "value2": "SI"
            }
          ]
        }
      },
      "position": [680, 300]
    },
    {
      "id": "6",
      "name": "¿Es CANCELAR?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.texto }}",
              "operation": "equal",
              "value2": "CANCELAR"
            }
          ]
        }
      },
      "position": [900, 420]
    },
    {
      "id": "4",
      "name": "Confirmar cita en OpsDental",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/n8n/confirmar-por-whatsapp",
        "bodyParametersUi": {
          "parameter": [{ "name": "telefono", "value": "={{ $json.telefono }}" }]
        }
      },
      "position": [900, 160]
    },
    {
      "id": "5",
      "name": "Cancelar cita en OpsDental",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/n8n/cancelar-por-whatsapp",
        "bodyParametersUi": {
          "parameter": [{ "name": "telefono", "value": "={{ $json.telefono }}" }]
        }
      },
      "position": [1120, 420]
    },
