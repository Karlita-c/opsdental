{
  "name": "OpsDental — Recordatorios diarios WhatsApp",
  "nodes": [
    {
      "id": "trigger-cron",
      "name": "Cron 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 24, "triggerAtHour": 9 }] }
      },
      "position": [250, 300]
    },
    {
      "id": "get-citas",
      "name": "Obtener citas de mañana",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8000/api/n8n/citas-manana",
        "headers": { "Authorization": "Bearer opsdental_n8n_2026" }
      },
      "position": [450, 300]
    },
    {
      "id": "loop-citas",
      "name": "Por cada cita",
      "type": "n8n-nodes-base.splitInBatches",
      "parameters": { "batchSize": 1 },
      "position": [650, 300]
    },
    {
      "id": "send-wa",
      "name": "Enviar recordatorio WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/1238253316039413/messages",
        "headers": { "Authorization": "Bearer EAA9FgBwdXPwBSN6eeqdDj5V9d3nzFYSjpPFPoZBOUKoufoh6oeI5Gqtsk2qXxzJDYeKAhjqKwKsyD4XvaWVkQFHRj6Jm1GJclv4PjYOPhICdoPTeUaT4fHl9yAXqZBWWTlFkTENkxzlFiQiXEb2xaai4oi2uId10d4ZChOf9U2jAagc8mZA6kojirFCYM1ZCknpDCAYAIh0uwZBqLzgv18fQuGvLGFAeSTZAS5pypbkZAHk4uu81gbg8cNjzELHMeCab3Q8AYxvPZCajWN9fT0gLkU4LqQgZDZD" },
        "body": {
          "messaging_product": "whatsapp",
          "to": "={{ $json.telefono }}",
          "type": "text",
          "text": { "body": "=👋 Hola {{ $json.nombre }}, te recordamos tu cita mañana {{ $json.fecha }} a las {{ $json.hora }} en {{ $json.consultorio }}. Responde SÍ para confirmar o CANCELAR si no puedes." }
        }
      },
      "position": [850, 300]
    }
  ],
  "connections": {
    "Cron 9AM": { "main": [[{ "node": "Obtener citas de mañana", "type": "main", "index": 0 }]] },
    "Obtener citas de mañana": { "main": [[{ "node": "Por cada cita", "type": "main", "index": 0 }]] },
    "Por cada cita": { "main": [[{ "node": "Enviar recordatorio WhatsApp", "type": "main", "index": 0 }]] }
  }
}
