# ================================================================
# OpsDental — Variables de entorno para Docker (EJEMPLO)
# Copia este archivo como .env.docker y rellena los valores reales
# ================================================================

# App
APP_NAME=OpsDental
APP_ENV=production
APP_KEY=                          # Generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=http://localhost

# Base de datos
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=opsdental_db
DB_USERNAME=postgres
DB_PASSWORD=                      # Elige una contraseña segura

# Redis
CACHE_STORE=redis
CACHE_PREFIX=opsd
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Colas y sesión
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Mail
MAIL_MAILER=log

# Frontend
FRONTEND_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ── Meta WhatsApp Business Cloud API ─────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ── Google Calendar API ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# ── Mercado Pago ──────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# ── N8N ──────────────────────────────────────────────────────────
N8N_PASSWORD=                     # Elige una contraseña segura
